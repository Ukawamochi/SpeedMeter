__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store

# リポジトリ直下の data/ のみ無視する（src/spkrate/data/ は対象外）
/data/*
!/data/DATASETS.md
runs/

# results/error_cases/ の音声（第6段階6-1）。Common Voice は再ホスト・再共有が
# 禁止されており、Public リポジトリにコミットすると再配布になるため追跡しない。
# 一覧（index.tsv）と README.md はテキストなのでコミットする。
/results/error_cases/*.mp3

# results/alignment_check/ の音声（タスク4-2）。Common Voice は再共有禁止のため追跡しない。
# ラベル（.txt）・index.tsv・README.md・record.md はテキストなのでコミットする。
/results/alignment_check/*.wav

# 人間の聴取用に音量をそろえた音声のコピー（Common Voice は再共有禁止）
/listening/*/

# 実環境評価の読み上げ文（第9段階 9-1）。JSUT の文そのもの（sentences.txt・
# sentences_labeled.tsv）は、再配布の条件の確認（docs/questions.md）が済むまで追跡しない。
# 手順書と選び方（文IDとモーラ数だけ）は追跡する。録音（data/eval_real/）は追跡しない。
!/data/eval_scripts/
/data/eval_scripts/*
!/data/eval_scripts/README.md
!/data/eval_scripts/selection.json

# 確認用ページ（web/）が読むモデル。scripts/setup_web_model.py が置く（リポジトリに入れない）
/web/models/

# Claude Code の設定ディレクトリ
.claude/

# Chrome 拡張機能（extension/）が読む、実行時に置くファイル。scripts/build_extension.py が作る
/extension/models/
/extension/vendor/
